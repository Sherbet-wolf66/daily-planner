

import sys
from PySide6.QtWidgets import (
    QApplication,
    QCalendarWidget,
    QLabel,
    QLineEdit,
    QMainWindow,
    QPushButton,
    QVBoxLayout,
    QWidget,
)

class MainWindow(QMainWindow):
    def __init__(self):
        super().__init__()

        self.setWindowTitle("Daily Planner")
        self.setContentsMargins(12, 12, 12, 12)
        self.resize(640, 480)
        layout = QVBoxLayout()

        title_label = QLabel("Welcome to the daily planner! This will help you keep track of events.")

        self.event_input = QLineEdit(placeholderText="Name")

        #calendar
        cal_label = QLabel("Select day ")
        self.cal_input = QCalendarWidget()

        submit_button = QPushButton("Submit")
        submit_button.clicked.connect(self.get_input)

        self.instructions = "Enter the name of the event, then click the continue button. Make sure to capitalize your event's name!"
        self.output_label = QLabel(self.instructions)

        layout.addWidget(title_label)
        layout.addWidget(self.event_input)
        layout.addWidget(cal_label)
        layout.addWidget(self.cal_input)
        layout.addWidget(submit_button)
        layout.addWidget(self.output_label)
        layout.addStretch()

        widget = QWidget()
        widget.setLayout(layout)
        self.setCentralWidget(widget)

    def get_input(self):
        output = ""
        event_name = self.event_input.text()

        date = self.cal_input.selectedDate()
        day = date.day()
        month = date.month()
        date_str = date.toString()

        if not event_name:
                output = "Warning: you did not enter an event. Please enter "
                output += "the event name. Please make sure to capitalize your event's name!"
        else:
            output = f"{event_name} on {date_str} "
            
        
        self.output_label.setText(output)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.show()

    app.exec()